{
  "expo": {
    "name": "Koi",
    "slug": "koi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sandosit.koi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C42E57",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sandosit.koi"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Koi",
      "shortName": "Koi",
      "backgroundColor": "#14201B",
      "themeColor": "#14201B"
    },
    "plugins": [
      "expo-font",
      "expo-router"
    ],
    "scheme": "koi",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4d278dcd-2634-409b-befa-2d24c41c40bc"
      }
    },
    "owner": "sandosit"
  }
}
