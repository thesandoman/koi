  "narrative": {
    "northStar": "The Tracing-Paper Pond",
    "overview": "Koi looks like a Bangkok street map drawn on tracing paper, laid over a pond. The ground is a cool paper in daylight and a deep pond green-black at night. Roads are dotted hairlines, the river a soft band, parks pale leaf patches, and the only things on top are places: leaf-green pins. People never appear. Everything is shown through one phone that follows the reader down the page.\n\nThe tone is calm and grown-up. Type is big and tight and carries the personality; surfaces stay quiet. Rose is rationed to primary actions and the unlock. The signature is a ripple that spreads from every pin you drop and, in rose, from the unlock.",
    "keyCharacteristics": [
      "Cool paper or pond ground, never warm cream.",
      "Large Bricolage Grotesque headings, Inter for reading, Noto Sans Thai for Thai.",
      "One device (the phone) as the main stage; no feature-card grid.",
      "Leaf green means private, safe, confirmed. Rose means act or unlock.",
      "Motion answers a touch: pin drop spring, ripple, sliding pill, screen swap."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Rose covers a small share of any view and never decorates. If it is not an action or an unlock, it is not rose.",
        "section": "colors"
      },
      {
        "name": "The Leaf Means State Rule",
        "body": "Green only ever says yours, private, safe, or confirmed.",
        "section": "colors"
      },
      {
        "name": "The Tight Headline Rule",
        "body": "Headlines tighten tracking (never below -0.04em) in Latin and reset to 0 in Thai.",
        "section": "typography"
      },
      {
        "name": "The Lifted Objects Only Rule",
        "body": "If a thing is not a device, a floating bar, or a notification, it gets no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep rose to primary actions and the unlock panel.",
      "Do ripple from the pin (leaf) and from the unlock (rose).",
      "Do keep the ground cool: Cool Paper by day, Pond by night.",
      "Do label example people and places as examples.",
      "Do keep tap targets at 44px or more and run every string in Thai and English."
    ],
    "donts": [
      "Don't add feature cards with an icon, a heading and text.",
      "Don't put people, faces or live locations on the map.",
      "Don't use gradients, glass blur or hard offset shadows.",
      "Don't add eyebrow labels above headings or numbered steps.",
      "Don't invent statistics, testimonials or partner names."
    ]
  }
}